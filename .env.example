# Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# Application Settings
# ============================================
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000

# ============================================
# Frontend Configuration
# ============================================
# API URL exposed to browser
NEXT_PUBLIC_API_URL=http://localhost:4000

# ============================================
# Database Configuration
# ============================================
# PostgreSQL database settings
POSTGRES_DB=task_processor
POSTGRES_USER=task_user
# IMPORTANT: Change this password in production!
POSTGRES_PASSWORD=changeme

# Full PostgreSQL connection string
# Format: postgres://user:password@host:port/database
DATABASE_URL=postgres://task_user:changeme@postgres:5432/task_processor

# ============================================
# Redis Configuration
# ============================================
# Redis connection string
REDIS_URL=redis://redis:6379

# ============================================
# AWS Configuration (for production deployment)
# ============================================
# AWS region for deployment
AWS_REGION=ap-south-1

# AWS Account ID (get from AWS console)
AWS_ACCOUNT_ID=

# ECS cluster name
ECS_CLUSTER=

# ECS service name
ECS_SERVICE=

# ============================================
# Jenkins Credentials (set in Jenkins, not here)
# ============================================
# Note: The following should be configured as Jenkins credentials:
# - aws-region
# - aws-account-id
# - aws-access-key-id
# - aws-secret-access-key
# - sonar-token
#
# Do NOT commit these to version control!
# Use Jenkins credentials store or AWS IAM roles instead.

# ============================================
# Optional: SonarQube Configuration
# ============================================
# SONAR_HOST_URL=http://localhost:9000
# SONAR_LOGIN=your-sonar-token
